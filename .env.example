# ═══════════════════════════════════════════════════════════════
#  SicariusGuard — Token Safety API & MCP Server
# ═══════════════════════════════════════════════════════════════

# Solana RPC (Helius recommended for reliability)
HELIUS_RPC_URL=https://api.mainnet-beta.solana.com

# API Server
PORT=3400
HOST=0.0.0.0

# Jupiter API (for honeypot sell simulation — no key needed for quotes)
JUPITER_API_BASE=https://api.jup.ag/swap/v1

# Birdeye API (optional — enables market intelligence enrichment)
# Get a free key at https://birdeye.so
BIRDEYE_API_KEY=

# Rate Limiting (free tier)
FREE_TIER_CALLS_PER_DAY=100

# Upstash Redis (optional — enables persistent rate limiting across instances)
# Get free credentials at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cache TTL (seconds)
CACHE_TTL_SECONDS=300

# x402 Payment Protocol (SOL micropayments)
# Wallet address where API payments are received
TREASURY_WALLET=5QMsfrUcaJ8WgD98MD8NJ3aEHvYz443QqFEJqGXbyLFM
